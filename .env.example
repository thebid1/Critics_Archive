# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Stage 2+) ---
# Publishable key (new-style, anon-equivalent, RLS enforced) — safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only "secret" key (sb_secret_…) — required from Stage 5 (orders / stock writes).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — LOCAL MIGRATION SCRIPTS ONLY (scripts/db-*.mjs).
DATABASE_URL=

# --- Paystack (Stage 5+) ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Resend (Stage 6+) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@criticsarchive.com
# Comma-separated emails to notify on each new order (the store owner).
ORDERS_NOTIFY_EMAIL=

# --- Admin (Stage 7+) ---
# Comma-separated emails allowed to sign in to /admin (lowercased/trimmed at
# read time). Magic-link only, no passwords, no self-service signup.
ADMIN_ALLOWED_EMAILS=you@example.com

# --- Cloudinary (Stage 7 admin image uploads) ---
# Server-side signing credentials. The API secret must NEVER be in client code
# or a NEXT_PUBLIC_* variable — the admin upload route signs params server-side.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cloudinary (Stage 1+) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin subdomain (Stage 13+) ---
# Origin of the admin app (admin.criticsarchive.com). Used by proxy.ts routing and
# the "view order in admin" link in owner notification emails.
ADMIN_SITE_URL=https://admin.criticsarchive.com

# --- Cron (Stage 12+) ---
# Secret that Vercel Cron sends in the Authorization header. Generate a long random string.
CRON_SECRET=

# --- Community email (Stage 12+) ---
# Sender for the newsletter welcome email.
COMMUNITY_FROM_EMAIL=community@confirm.criticsarchive.com
